{
  "name": "issue-criticity",
  "private": true,
  "version": "0.1.0",
  "description": "Local-only GitHub issue triage tool that scores complexity, criticality, cost and relevance with calibrated Jev judgments.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.11.7",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
