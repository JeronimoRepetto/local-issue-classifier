{
  "name": "local-issue-classifier",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first web app that pulls a GitHub repo's issues and README, then asks Jev (TypeSafe AI's decision model) to rate each issue by complexity, criticality, effort and relevance. Filter, dismiss, sort by weighted priority and export as plain text. Keys stay in memory; results stay in your browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JeronimoRepetto/local-issue-classifier"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "icons": "node scripts/build-icons.mjs",
    "favicons": "node scripts/build-favicon-png.mjs",
    "hygiene": "node scripts/check-hygiene.mjs",
    "local:kev": "node scripts/local-kev.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/geist-pixel": "^5.3.0",
    "@tanstack/vue-virtual": "^3.13.39",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^15.11.7",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
