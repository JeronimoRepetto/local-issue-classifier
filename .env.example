# Non-secret configuration only. Secrets (Jev key, GitHub token) are entered
# at runtime and never read from .env.
VITE_JEV_BASE_URL=/jev

# Where the local Jev proxy (server/jevProxy.ts) forwards requests. Read by
# vite.config.ts only, never bundled into the browser. Uncomment to point the
# proxy at a different Jev-compatible upstream; the default is api.typesafe.ai.
# JEV_UPSTREAM_URL=https://api.typesafe.ai
