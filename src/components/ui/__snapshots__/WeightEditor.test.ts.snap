      <div data-v-7401b5d6="" class="ui-slider__row"><input data-v-7401b5d6="" id="slider-v-1" class="ui-slider__range" type="range" min="0" max="100" step="5" aria-valuetext="40" value="40"><input data-v-7401b5d6="" class="ui-control ui-slider__number u-tabular" type="number" min="0" max="100" step="5" aria-label="Criticality · 40 (40%) value" value="40"></div>
    </div>
  </div>
  <div data-v-da0ac6c1="" class="weight-editor__row">
    <div data-v-7401b5d6="" data-v-da0ac6c1="" class="ui-field ui-slider" data-test="weight-relevance"><label data-v-7401b5d6="" class="ui-field__label" for="slider-v-2">Relevance · 30 (30%)</label>
