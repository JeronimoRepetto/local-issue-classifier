      <div data-v-7401b5d6="" class="ui-slider__row"><input data-v-7401b5d6="" id="slider-v-3" class="ui-slider__range" type="range" min="0" max="100" step="5" aria-valuetext="15" value="15"><input data-v-7401b5d6="" class="ui-control ui-slider__number u-tabular" type="number" min="0" max="100" step="5" aria-label="Complexity · 15 (15%) value" value="15"></div>
